# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Web API key. Use a newly rotated, application-restricted key.
VITE_FIREBASE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional frontend override if your API runs on a different origin.
VITE_API_BASE_URL=""

# bKash Payment Gateway credentials
BKASH_BASE_URL=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""

# Optional: override the frontend callback base URL for bKash redirects.
BKASH_CALLBACK_BASE_URL=""

# Optional: fallback subject unlock price when a subject document does not define unlockPrice.
BKASH_DEFAULT_SUBJECT_UNLOCK_PRICE="299"

# Firebase Admin credentials for the payment API server
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# SMTP configuration for password reset OTP emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
RESET_EMAIL_FROM=""
